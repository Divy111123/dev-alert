# ========================================================
# DevAlert Platform - Environment Configuration
# ========================================================

# App Core
PROJECT_NAME="DevAlert"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-secure-random-64-character-string"
FRONTEND_URL="http://localhost:5173"

# Database Configuration (PostgreSQL in production, SQLite supported for zero-config local testing)
DATABASE_URL="postgresql://devalert:devalert_secure_pass@localhost:5432/devalert_db"
# DATABASE_URL="sqlite:///./devalert.db"

# Redis & Celery Background Queue
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"
CELERY_ALWAYS_EAGER=false

# Email Delivery Modes: "smtp", "console", "file", or "mock"
EMAIL_MODE="smtp"
EMAIL_FILE_PATH="./data/emails"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="notifications@devalert.local"
SMTP_FROM_NAME="DevAlert Monitoring"
SMTP_USE_TLS=false
SMTP_USE_SSL=false

# AI Error Analysis Module (Optional)
AI_ANALYSIS_ENABLED=false
AI_API_KEY=""
AI_PROVIDER="gemini"

# Ingestion Security & Limits
RATE_LIMIT_PER_MINUTE=120

